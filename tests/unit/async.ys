# --- SR inference: per-bit mixed priority within one vector ---
design -reset
read_slang <<EOV
module dffsr_mixed_gate(input logic clk, input logic s, input logic r,
		input logic [1:0] d, output logic [1:0] q);
	always_ff @(posedge clk or posedge s or posedge r) begin
		if (s) begin
			q[0] <= 1'b1;
			q[1] <= 1'b0;
		end else if (r) begin
			q[0] <= 1'b0;
			q[1] <= 1'b1;
		end else begin
			q <= d;
		end
	end
endmodule
EOV
select -assert-count 2 t:$dffsre
select -clear

read_rtlil <<EOV
module \dffsr_mixed_gold
	wire input 1 \clk
	wire input 2 \s
	wire input 3 \r
	wire width 2 input 4 \d
	wire width 2 output 5 \q
	wire $1

	cell $mux $2
		parameter \WIDTH 1
		connect \A \r
		connect \B 1'0
		connect \S \s
		connect \Y $1
	end

	cell $dffsre $3
		parameter \CLK_POLARITY 1
		parameter \EN_POLARITY 1
		parameter \SET_POLARITY 1
		parameter \CLR_POLARITY 1
		parameter \WIDTH 1
		connect \CLK \clk
		connect \EN 1'1
		connect \SET \s
		connect \CLR $1
		connect \D \d [0]
		connect \Q \q [0]
	end

	cell $dffsre $4
		parameter \CLK_POLARITY 1
		parameter \EN_POLARITY 1
		parameter \SET_POLARITY 1
		parameter \CLR_POLARITY 1
		parameter \WIDTH 1
		connect \CLK \clk
		connect \EN 1'1
		connect \SET $1
		connect \CLR \s
		connect \D \d [1]
		connect \Q \q [1]
	end
end
EOV
clk2fflogic
miter -equiv -make_assert -flatten dffsr_mixed_gold dffsr_mixed_gate dffsr_mixed_miter
hierarchy -top dffsr_mixed_miter
sat -verify -prove-asserts -enable_undef -set-init-undef -show-public -seq 3 dffsr_mixed_miter

# --- SR inference combined with clock enable (iff) ---
design -reset
read_slang <<EOV
module dffsr_iff_gate(input logic clk, input logic en, input logic s, input logic r,
		input logic d, output logic q);
	always_ff @(posedge clk iff en or posedge s or posedge r) begin
		if (s) q <= 1'b1;
		else if (r) q <= 1'b0;
		else q <= d;
	end
endmodule
EOV
