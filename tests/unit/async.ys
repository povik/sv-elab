module dffsr_bad(input logic clk, input logic s, input logic r,
		input logic d, output logic q);
	always_ff @(posedge clk or posedge s or posedge r) begin
		if (s) q <= 1'b1;
		else if (r) q <= 1'b1;
		else q <= d;
	end
endmodule
EOV

# --- SR inference: asynchronous set/reset on a dual-edge clock is rejected ---
