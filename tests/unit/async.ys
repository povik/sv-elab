module dffsr_dual_edge(input logic clk, input logic s, input logic r,
		input logic d, output logic q);
	always_ff @(edge clk or posedge s or posedge r) begin
		if (s) q <= 1'b1;
		else if (r) q <= 1'b0;
		else q <= d;
	end
endmodule
EOV

