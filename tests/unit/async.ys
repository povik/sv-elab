# --- SR inference: more than two asynchronous branches is rejected ---
design -reset
test_slangdiag -expect "process has 3 asynchronous load branches, at most 2 are supported"
read_slang <<EOV
module dffsr_too_many(input logic clk, input logic a, input logic b, input logic c,
		input logic d, output logic q);
	always_ff @(posedge clk or posedge a or posedge b or posedge c) begin
		if (a) q <= 1'b1;
		else if (b) q <= 1'b0;
		else if (c) q <= 1'b1;
		else q <= d;
	end
endmodule
EOV

