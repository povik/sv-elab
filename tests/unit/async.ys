# --- SR inference: set branch first (requires gating clear with !set) ---
design -reset
read_slang <<EOV
module dffsr_set_first_gate(input logic clk, input logic s, input logic r,
		input logic d, output logic q);
	always_ff @(posedge clk or posedge s or posedge r) begin
		if (s) q <= 1'b1;
		else if (r) q <= 1'b0;
		else q <= d;
	end
endmodule
EOV
select -assert-count 1 t:$dffsre
select -clear

read_rtlil <<EOV
module \dffsr_set_first_gold
	wire input 1 \clk
	wire input 2 \s
	wire input 3 \r
	wire input 4 \d
	wire output 5 \q
	wire $1

	cell $mux $2
		parameter \WIDTH 1
		connect \A \r
		connect \B 1'0
		connect \S \s
		connect \Y $1
	end

	cell $dffsre $3
		parameter \CLK_POLARITY 1
		parameter \EN_POLARITY 1
		parameter \SET_POLARITY 1
		parameter \CLR_POLARITY 1
		parameter \WIDTH 1
		connect \CLK \clk
		connect \EN 1'1
		connect \SET \s
		connect \CLR $1
		connect \D \d
		connect \Q \q
	end
end
EOV
clk2fflogic
miter -equiv -make_assert -flatten dffsr_set_first_gold dffsr_set_first_gate dffsr_set_first_miter
hierarchy -top dffsr_set_first_miter
sat -verify -prove-asserts -enable_undef -set-init-undef -show-public -seq 3 dffsr_set_first_miter

