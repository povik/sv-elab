# --- SR inference: active-low async inputs, set branch first ---
design -reset
read_slang <<EOV
module dffsr_active_low_gate(input logic clk, input logic set_n, input logic rst_n,
		input logic d, output logic q);
	always_ff @(posedge clk or negedge set_n or negedge rst_n) begin
		if (!set_n) q <= 1'b1;
		else if (!rst_n) q <= 1'b0;
		else q <= d;
	end
endmodule
EOV
select -assert-count 1 t:$dffsre
select -clear

read_rtlil <<EOV
module \dffsr_active_low_gold
	wire input 1 \clk
	wire input 2 \set_n
	wire input 3 \rst_n
	wire input 4 \d
	wire output 5 \q
	wire $1
	wire $4
	wire $5

	cell $not $2
		parameter \A_SIGNED 0
		parameter \A_WIDTH 1
		parameter \Y_WIDTH 1
		connect \A \set_n
		connect \Y $1
	end

	cell $not $3
		parameter \A_SIGNED 0
		parameter \A_WIDTH 1
		parameter \Y_WIDTH 1
		connect \A \rst_n
		connect \Y $4
	end

	cell $mux $6
		parameter \WIDTH 1
		connect \A $4
		connect \B 1'0
		connect \S $1
		connect \Y $5
	end

	cell $dffsre $7
		parameter \CLK_POLARITY 1
		parameter \EN_POLARITY 1
		parameter \SET_POLARITY 1
		parameter \CLR_POLARITY 1
		parameter \WIDTH 1
		connect \CLK \clk
		connect \EN 1'1
		connect \SET $1
		connect \CLR $5
		connect \D \d
		connect \Q \q
	end
end
EOV
