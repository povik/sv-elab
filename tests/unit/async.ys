	wire $1

	cell $mux $2
		parameter \WIDTH 1
		connect \A \r
		connect \B 1'0
		connect \S \s
		connect \Y $1
	end

	cell $dffsre $3
		parameter \CLK_POLARITY 1
		parameter \EN_POLARITY 1
		parameter \SET_POLARITY 1
		parameter \CLR_POLARITY 1
		parameter \WIDTH 1
		connect \CLK \clk
		connect \EN \en
		connect \SET \s
		connect \CLR $1
		connect \D \d
		connect \Q \q
